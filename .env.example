# Reportthy & JupyterHub Environment Configuration

# Public URL accessible from the researcher's browser (used in iframe src)
JUPYTERHUB_PUBLIC_URL=http://localhost:8000

# Internal URL accessible from the Next.js backend (http://jupyterhub:8000 in Docker, http://localhost:8000 in local dev)
JUPYTERHUB_INTERNAL_URL=http://localhost:8000

# Admin API token configured in jupyterhub_config.py services
JUPYTERHUB_API_TOKEN=reportthy-dev-token

# Target JupyterHub username to spawn and manage notebooks for
JUPYTERHUB_USER=researcher

# Reportthy internal backend URL accessible from Jupyter kernels to fetch datasets and sync results
REPORTTHY_INTERNAL_URL=http://localhost:3000
